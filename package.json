{
  "name": "obsidian-hybrid-chat",
  "version": "0.1.5",
  "description": "Privacy-conscious federated RAG chat over existing Obsidian Hybrid Search services",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build && npm run verify:bundle",
    "package-release": "npm run check && node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.12.0",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.5"
  }
}
